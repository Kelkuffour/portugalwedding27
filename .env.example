# Connect a Neon Postgres database in Vercel Storage. Keep this server-only.
# The integration sets DATABASE_URL; POSTGRES_URL is also accepted.
# Never use a VITE_ prefix for a database secret.
DATABASE_URL=""

# Local development without DATABASE_URL keeps using the ignored data/ directory.
# Vercel requires DATABASE_URL and never falls back to local files.
INVITATION_DATA_DIR=""
